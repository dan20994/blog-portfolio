---
interface CertField {
  id: string;
  title: string;
  paragraphs: string[];
  table?: { oid: string; type: string }[];
}

const FIELDS: CertField[] = [
  {
    id: 'policies',
    title: 'X509v3 Certificate Policies — el más importante',
    paragraphs: [
      'El OID 2.23.140.1.2.1 identifica la política de validación de dominio del CA/Browser Forum. Es el único campo de este certificado que indica su tipo de validación.',
      'Los requisitos criptográficos de los Baseline Requirements no dependen de este valor: son idénticos para los cuatro.',
    ],
    table: [
      { oid: '2.23.140.1.2.1', type: 'DV' },
      { oid: '2.23.140.1.2.2', type: 'OV' },
      { oid: '2.23.140.1.2.3', type: 'IV' },
      { oid: '2.23.140.1.1', type: 'EV' },
    ],
  },
  {
    id: 'key-usage',
    title: 'X509v3 Key Usage',
    paragraphs: [
      'Solo Digital Signature. No aparece keyEncipherment porque una clave ECDSA no puede cifrar nada: solo firmar.',
      'Esta clave pública es criptográficamente incapaz de cifrar el tráfico. El cifrado del canal lo produce un intercambio de claves efímero (ECDHE) durante el handshake; el certificado solo interviene para probar identidad.',
    ],
  },
  {
    id: 'subject',
    title: 'Subject (vacío)',
    paragraphs: [
      'No contiene nada. El nombre de dominio ya no puede ir en el commonName, y un certificado DV no incorpora información de organización.',
      'Un certificado OV o EV sí llevaría aquí el nombre legal de la empresa, su localidad y, en EV, su jurisdicción de incorporación. Esa información es el registro de lo que la CA verificó, no un componente criptográfico.',
    ],
  },
  {
    id: 'validity',
    title: 'Validity',
    paragraphs: [
      "Del 19 al 26 de febrero de 2025: 160 horas, poco más de seis días. Es el perfil de vida corta de Let's Encrypt.",
      'La validez corta reduce la ventana de exposición si una clave privada se compromete, y solo es sostenible con renovación automatizada. Los Baseline Requirements van en esa dirección para toda la industria: 200 días de máximo desde marzo de 2026, 100 desde marzo de 2027 y 47 desde marzo de 2029.',
    ],
  },
  {
    id: 'san',
    title: 'Subject Alternative Name',
    paragraphs: [
      'El único lugar donde vive la identidad del certificado. Los navegadores solo miran aquí; el commonName se ignora desde hace años.',
      'Está marcado como crítico porque el Subject está vacío: cuando eso ocurre, la norma obliga a que el SAN sea crítico. Es el campo que el cliente compara con el dominio al que se conectó.',
    ],
  },
];

function fieldButton(id: string, label: string) {
  return `<button type="button" class="cert-field" data-field="${id}">${label}</button>`;
}

