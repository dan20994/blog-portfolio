const certHtml = CERT_RAW.replace('Validity\n', `${fieldButton('validity', 'Validity')}\n`)
  .replace('Subject:', `${fieldButton('subject', 'Subject')}:`)
  .replace('X509v3 Key Usage:', `${fieldButton('key-usage', 'X509v3 Key Usage')}:`)
  .replace(
    'X509v3 Subject Alternative Name:',
    `${fieldButton('san', 'X509v3 Subject Alternative Name')}:`,
  )
  .replace(
    'X509v3 Certificate Policies:',
    `${fieldButton('policies', 'X509v3 Certificate Policies')}:`,
  );
---

<details class="cert-details">
  <summary>
    <span class="chevron">▸</span>
    <span class="label">ver certificado de ejemplo</span>
    <span class="hint">helloworld.letsencrypt.org</span>
  </summary>
  <p class="cert-hint">Haz clic en los campos resaltados para ver qué significan.</p>
  <pre class="cert-pre" set:html={certHtml} />
</details>

<dialog id="cert-field-dialog" class="cert-dialog" data-fields={JSON.stringify(FIELDS)}>
  <button type="button" class="cert-dialog-close" aria-label="Cerrar" id="cert-dialog-close">
    ×
  </button>
  <h4 id="cert-dialog-title"></h4>
  <div id="cert-dialog-body"></div>
</dialog>

<script>
  interface CertField {
    id: string;
    title: string;
    paragraphs: string[];
    table?: { oid: string; type: string }[];
  }

  const dialog = document.getElementById('cert-field-dialog') as HTMLDialogElement | null;
  const titleEl = document.getElementById('cert-dialog-title');
  const bodyEl = document.getElementById('cert-dialog-body');
  const closeBtn = document.getElementById('cert-dialog-close');
  const fields: CertField[] = JSON.parse(dialog?.dataset.fields ?? '[]');

  document.querySelectorAll<HTMLElement>('.cert-field').forEach((btn) => {
    btn.addEventListener('click', () => {
      const field = fields.find((f) => f.id === btn.dataset.field);
      if (!field || !dialog || !titleEl || !bodyEl) return;

      titleEl.textContent = field.title;
      bodyEl.replaceChildren();

      field.paragraphs.forEach((text, i) => {
        const p = document.createElement('p');
        p.textContent = text;
        bodyEl.appendChild(p);

        if (i === 0 && field.table) {
          const table = document.createElement('table');
          const headRow = table.createTHead().insertRow();
          ['OID', 'Tipo'].forEach((label) => {
            const th = document.createElement('th');
            th.textContent = label;
            headRow.appendChild(th);
          });
          const tbody = table.createTBody();
          field.table.forEach((row) => {
            const tr = tbody.insertRow();
            tr.insertCell().textContent = row.oid;
            tr.insertCell().textContent = row.type;
          });
          bodyEl.appendChild(table);
        }
      });

      dialog.showModal();
    });
  });

  closeBtn?.addEventListener('click', () => dialog?.close());

  dialog?.addEventListener('click', (event) => {
    const rect = dialog.getBoundingClientRect();
    const inside =
      event.clientX >= rect.left &&
      event.clientX <= rect.right &&
      event.clientY >= rect.top &&
      event.clientY <= rect.bottom;
    if (!inside) dialog.close();
  });
</script>

<style>
  .cert-details {
    margin: 28px 0;
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
  }

  .cert-details summary {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 20px;
    border-bottom: 1px solid transparent;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-subtle);
    list-style: none;
  }

  .cert-details summary::-webkit-details-marker {
    display: none;
  }

  .cert-details[open] summary {
    border-bottom-color: var(--color-border-strong);
  }

  .cert-details .chevron {
    display: inline-block;
    transition: transform 0.15s ease;
    color: var(--color-accent);
  }

  .cert-details[open] .chevron {
    transform: rotate(90deg);
  }

  .cert-details summary .label {
    color: var(--color-muted);
  }

  .cert-details summary .hint {
    margin-left: auto;
    color: var(--color-faint);
  }

  .cert-hint {
    margin: 0;
    padding: 12px 24px 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--color-faint);
  }

  .cert-pre {
    margin: 0;
    padding: 16px 24px 22px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.7;
    color: oklch(78% 0.014 95);
    white-space: pre;
  }

  .cert-pre :global(.cert-field) {
    all: unset;
    cursor: pointer;
    color: var(--color-accent);
    text-decoration: underline dotted;
    text-underline-offset: 3px;
  }

  .cert-pre :global(.cert-field:hover),
  .cert-pre :global(.cert-field:focus-visible) {
    color: var(--color-accent-hover);
    background: oklch(78% 0.15 55 / 0.12);
  }

  .cert-dialog {
    position: fixed;
    inset: 0;
    margin: auto;
    max-width: 520px;
    width: calc(100vw - 48px);
    max-height: calc(100vh - 48px);
    overflow-y: auto;
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg);
    color: var(--color-fg);
    padding: 28px;
  }

  .cert-dialog::backdrop {
    background: oklch(10% 0.005 250 / 0.7);
    backdrop-filter: blur(4px);
  }

  .cert-dialog-close {
    all: unset;
    position: absolute;
    top: 14px;
    right: 18px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 18px;
    line-height: 1;
    color: var(--color-subtle);
  }

  .cert-dialog-close:hover {
    color: var(--color-fg);
  }

  #cert-dialog-title {
    margin: 0 24px 14px 0;
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-accent);
  }

  #cert-dialog-body :global(p) {
    margin: 0 0 14px;
    font-family: var(--font-sans);
    font-size: 14.5px;
    line-height: 1.65;
    color: oklch(82% 0.014 95);
  }

  #cert-dialog-body :global(p:last-child) {
    margin-bottom: 0;
  }

  #cert-dialog-body :global(table) {
    width: 100%;
    margin: 4px 0 18px;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 12.5px;
  }

  #cert-dialog-body :global(th),
  #cert-dialog-body :global(td) {
    border: 1px solid var(--color-border);
    padding: 6px 10px;
    text-align: left;
  }

  #cert-dialog-body :global(th) {
    color: var(--color-subtle);
    font-weight: 600;
    background: var(--color-surface);
  }
</style>
