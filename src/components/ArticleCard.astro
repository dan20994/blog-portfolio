---
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';
import { formatDate, formatReadTime } from '../lib/format';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, excerpt, category, date, readTime } = entry.data;
---

<a
  href={`/blog/${entry.id}`}
  data-category={category}
  class="flex flex-col text-inherit no-underline"
>
  <div
    class="hatch-bg mb-4 flex aspect-[16/9] items-center justify-center border border-border"
  >
    <span class="font-mono text-[11px] text-faint">img_placeholder.svg</span>
  </div>
  <Tag category={category} />
  <div class="mt-2.5 mb-2.5 font-mono text-[19px] leading-[1.3] font-semibold text-fg-strong">
    {title}
  </div>
  <p class="mb-4 flex-1 text-[14.5px] leading-[1.6] text-muted">{excerpt}</p>
  <div class="flex items-center gap-3 font-mono text-[11.5px] text-subtle">
    <span>{formatDate(date)}</span><span>·</span><span>{formatReadTime(readTime)}</span>
  </div>
</a>
