---
import { CATEGORIES, type CategoryId } from '../lib/categories';

interface Props {
  category: CategoryId;
  dot?: boolean;
  class?: string;
}

const { category, dot = false, class: className = '' } = Astro.props;
const { label, textClass, bgClass } = CATEGORIES[category];
---

<span
  class={`inline-flex items-center gap-1.5 font-mono text-[11px] font-semibold tracking-[0.05em] uppercase ${textClass} ${className}`}
>
  {dot && <span class={`inline-block h-1.5 w-1.5 ${bgClass}`} />}
  {label}
</span>
