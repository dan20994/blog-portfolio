---
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';

interface Props {
  entries: CollectionEntry<'blog'>[];
}

const { entries } = Astro.props;
---

{
  entries.length > 0 && (
    <div class="mx-auto max-w-[1180px] px-8 pt-6">
      <h3 class="mb-6 font-mono text-[13px] tracking-[0.06em] text-subtle uppercase">
        artículos relacionados
      </h3>
      <div class="grid grid-cols-1 gap-8 pb-16 sm:grid-cols-2 lg:grid-cols-3">
        {entries.map((entry) => (
          <a href={`/blog/${entry.id}`} class="flex flex-col text-inherit no-underline">
            <Tag category={entry.data.category} />
            <div class="mt-2.5 mb-2 font-mono text-[16.5px] leading-[1.35] font-semibold text-fg-strong">
              {entry.data.title}
            </div>
            <p class="text-[13.5px] leading-[1.6] text-subtle">{entry.data.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  )
}
